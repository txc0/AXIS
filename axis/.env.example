# Copy this file to .env and adjust.
NODE_ENV=development
PORT=3000
# SQLite file. Relative paths are resolved from the project root.
DATABASE_PATH=./data/axis.db
# Host port for Docker Compose (container always listens on 3000).
AXIS_HOST_PORT=3000
# Bind address. Use 127.0.0.1 behind a reverse proxy; use 0.0.0.0 for direct local access.
AXIS_HOST_BIND=0.0.0.0
# Backup directory and number of database copies to retain.
BACKUP_DIR=./data/backups
BACKUP_RETENTION=14
# Long random string. Needed to sign in at /admin. Leave empty to disable admin.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# SMTP settings. For Gmail, use smtp.gmail.com and a Google app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
# Seed only an empty database at startup. Set true to overwrite content from seed-data.js on startup.
SEED_ON_START=false
# Persistent image uploads managed from /admin.
UPLOAD_DIR=./data/uploads
# 1 when running behind a reverse proxy (Caddy, Nginx, Render). 0 when exposed directly.
TRUST_PROXY=0
# Browser-restricted Google Maps Embed API key. Leave blank to show a Maps link fallback.
VITE_GOOGLE_MAPS_API_KEY=